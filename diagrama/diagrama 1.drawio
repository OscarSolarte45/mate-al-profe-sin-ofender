        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n\nclass Main {\n    +main(String[] args) void\n}\n\nclass Arma {\n    -String nombre\n    -int golpebase\n    -double precision\n    +Arma(String nombre, int golpebase, double precision)\n    +getNombre() String\n    +getGolpebase() int\n    +getPrecision() double\n}\n\nclass Profesor {\n    -String nombre\n    -String materia\n    -int vidaActual\n    -int vidaMaxima\n    +Profesor(String nombre, String materia, int vidaMaxima)\n    +recibirGolpe(int cantidad) void\n    +seMurio() boolean\n    +getNombre() String\n    +getMateria() String\n    +getVidaActual() int\n    +getVidaMaxima() int\n}\n\nclass ProfesorFactory {\n    &lt;&lt;abstract&gt;&gt;\n    +crearProfesor() Profesor\n}\n\nclass ProfesorCalculoFactory {\n    +crearProfesor() Profesor\n}\n\nclass ProfesorProgramacionFactory {\n    +crearProfesor() Profesor\n}\n\nclass ProfesorFisicaFactory {\n    +crearProfesor() Profesor\n}\n\nclass EstrategiaAtaque {\n    &lt;&lt;interface&gt;&gt;\n    +ejecutarAtaque(Arma arma, ZonaCuerpo zona, Profesor profesor, ObservadorJuego observador) boolean\n}\n\nclass AtaqueEstandar {\n    -Random random\n    +ejecutarAtaque(Arma arma, ZonaCuerpo zona, Profesor profesor, ObservadorJuego observador) boolean\n}\n\nclass ObservadorJuego {\n    &lt;&lt;interface&gt;&gt;\n    +alNotificar(String mensaje) void\n}\n\nclass ConsolaNotificador {\n    +alNotificar(String mensaje) void\n}\n\nclass ZonaCuerpo {\n    &lt;&lt;enumeration&gt;&gt;\n    CABEZA\n    TORSO\n    EXTREMIDADES\n    -String nombre\n    -double multiplicadorGolpe\n    -double probabilidadAcierto\n    +getNombre() String\n    +getMultiplicadorGolpe() double\n    +getProbabilidadAcierto() double\n}\n\nProfesorCalculoFactory --|&gt; ProfesorFactory\nProfesorProgramacionFactory --|&gt; ProfesorFactory\nProfesorFisicaFactory --|&gt; ProfesorFactory\n\nProfesorCalculoFactory ..&gt; Profesor : crea\nProfesorProgramacionFactory ..&gt; Profesor : crea\nProfesorFisicaFactory ..&gt; Profesor : crea\n\nAtaqueEstandar ..|&gt; EstrategiaAtaque\nConsolaNotificador ..|&gt; ObservadorJuego\n\nMain ..&gt; ProfesorFactory : utiliza\nMain ..&gt; Arma : crea\nMain ..&gt; EstrategiaAtaque : utiliza\nMain ..&gt; ObservadorJuego : utiliza\nMain ..&gt; ZonaCuerpo : utiliza\n\nAtaqueEstandar ..&gt; Arma : utiliza\nAtaqueEstandar ..&gt; ZonaCuerpo : utiliza\nAtaqueEstandar ..&gt; Profesor : modifica\nAtaqueEstandar ..&gt; ObservadorJuego : notifica&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="MP_Q-lb6WOerQPQSoKv1-7">
